<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>挑戦ボード</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Noto Sans JP -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Firebase SDK (Modular) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithRedirect, getRedirectResult, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // 新しく作成したFirebaseプロジェクトの設定
        const firebaseConfig = {
            apiKey: "AIzaSyBHjBXbPCD1Q7_xT7mu7eIjEimIKxQzxrs",
            authDomain: "fire-board-b1a21.firebaseapp.com",
            projectId: "fire-board-b1a21",
            storageBucket: "fire-board-b1a21.firebasestorage.app",
            messagingSenderId: "433131318113",
            appId: "1:433131318113:web:90370ca4001f4eef47f320"
        };

        const appId = 'school-freeboard-shared-v2';

        let db, auth;
        let isFirebaseConnected = false;

        window.isAdminMode = (window.location.hash === '#admin-administrator-()');
        window.notesData = [];
        window.currentUser = null;
        window.isViewOnlyMode = false;
        window.loginSessions = JSON.parse(localStorage.getItem('freeboard_login_sessions') || '[]');

        window.initFirebase = async function() {
            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // iPad Safari等のリダイレクトログイン結果を受け取る
                try {
                    await getRedirectResult(auth);
                } catch (redirectErr) {
                    console.warn("Redirect result info:", redirectErr);
                }

                // 認証状態の監視
                onAuthStateChanged(auth, (user) => {
                    if (user && !user.isAnonymous) {
                        window.currentUser = {
                            uid: user.uid,
                            displayName: user.displayName || '名無しさん',
                            email: user.email || '',
                            photoURL: user.photoURL || ''
                        };
                        window.myCreatorId = user.uid;
                        window.isViewOnlyMode = false;

                        recordLoginSession(window.currentUser);
                        updateUserIconUI();
                        closeLoginModal();
                        if (typeof renderNotes === 'function') renderNotes();
                    } else {
                        window.currentUser = null;
                        window.myCreatorId = null;
                        updateUserIconUI();
                        // 閲覧モードをまだ選んでいない場合のみログインモーダルを表示
                        if (!window.isViewOnlyMode) {
                            openLoginModal();
                        }
                        if (typeof renderNotes === 'function') renderNotes();
                    }
                });

                isFirebaseConnected = true;
                updateConnectionIndicator(true);
                
                const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'notes');
                
                onSnapshot(colRef, (snapshot) => {
                    const notes = [];
                    snapshot.forEach(docSnap => {
                        notes.push({ id: docSnap.id, ...docSnap.data() });
                    });
                    
                    window.notesData = notes;
                    if (typeof renderNotes === 'function') renderNotes();
                    if (typeof renderSearchList === 'function') renderSearchList();
                }, (error) => {
                    console.warn("Firestore sync warning, falling back to local:", error);
                    fallbackToLocal();
                });

            } catch (e) {
                console.warn("Firebase connection failed, falling back to local:", e);
                fallbackToLocal();
            }
        };

        function recordLoginSession(user) {
            const sessions = JSON.parse(localStorage.getItem('freeboard_login_sessions') || '[]');
            const existingIndex = sessions.findIndex(s => s.uid === user.uid);
            const sessionData = {
                uid: user.uid,
                displayName: user.displayName,
                email: user.email,
                photoURL: user.photoURL,
                lastLoginAt: new Date().toISOString(),
                isCurrent: true
            };

            sessions.forEach(s => s.isCurrent = false);

            if (existingIndex >= 0) {
                sessions[existingIndex] = sessionData;
            } else {
                sessions.push(sessionData);
            }
            window.loginSessions = sessions;
            localStorage.setItem('freeboard_login_sessions', JSON.stringify(sessions));
            if (typeof renderAdminTabs === 'function') renderAdminTabs();
        }

        window.googleLogin = async function() {
            const btn = document.getElementById('google-login-btn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i><span>移動中...</span>';
            }
            try {
                const provider = new GoogleAuthProvider();
                // iPad / モバイルSafariで真っ白になるのを防ぐため、iPad/iPhone/Safari判定時はリダイレクトを使用
                const isMobileOrSafari = /iPad|iPhone|iPod/.test(navigator.userAgent) || 
                                         (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) ||
                                         (/^((?!chrome|android).)*safari/i.test(navigator.userAgent));

                if (isMobileOrSafari) {
                    await signInWithRedirect(auth, provider);
                } else {
                    await signInWithPopup(auth, provider);
                }
            } catch (e) {
                console.error("Google Login failed:", e);
                // ポップアップ失敗時はリダイレクトにフォールバック
                try {
                    const provider = new GoogleAuthProvider();
                    await signInWithRedirect(auth, provider);
                } catch (e2) {
                    alert("ログインできませんでした。FirebaseコンソールでGoogleログインが有効になっているか確認してください。\nエラー: " + e.message);
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<span>Googleアカウントでログイン</span>';
                    }
                }
            }
        };

        window.enterViewOnlyMode = function() {
            window.isViewOnlyMode = true;
            closeLoginModal();
            updateUserIconUI();
            if (typeof renderNotes === 'function') renderNotes();
        };

        window.logoutUser = async function() {
            if (confirm("ログアウトしますか？")) {
                try {
                    if (window.currentUser) {
                        const sessions = JSON.parse(localStorage.getItem('freeboard_login_sessions') || '[]');
                        sessions.forEach(s => s.isCurrent = false);
                        localStorage.setItem('freeboard_login_sessions', JSON.stringify(sessions));
                        window.loginSessions = sessions;
                    }
                    window.isViewOnlyMode = false;
                    await signOut(auth);
                } catch(e) {
                    console.error("Logout failed:", e);
                }
            }
        };

        function fallbackToLocal() {
            isFirebaseConnected = false;
            updateConnectionIndicator(false);
            const saved = localStorage.getItem('freeboard_local_notes');
            window.notesData = saved ? JSON.parse(saved) : [];
            
            if (!window.currentUser && !window.isViewOnlyMode) {
                openLoginModal();
            }

            if (typeof renderNotes === 'function') renderNotes();
            if (typeof renderSearchList === 'function') renderSearchList();
        }

        function updateConnectionIndicator(isConnected) {
            const indicator = document.getElementById('connection-indicator');
            const ping = document.getElementById('connection-ping');
            if (!indicator) return;

            if (isConnected) {
                indicator.className = 'w-3 h-3 rounded-full bg-emerald-500 relative flex items-center justify-center';
                if (ping) ping.classList.remove('hidden');
            } else {
                indicator.className = 'w-3 h-3 rounded-full bg-amber-500 relative flex items-center justify-center';
                if (ping) ping.classList.add('hidden');
            }
        }

        function updateUserIconUI() {
            const container = document.getElementById('user-icon-container');
            if (!container) return;

            if (window.currentUser) {
                const avatar = window.currentUser.photoURL ? 
                    `<img src="${window.currentUser.photoURL}" class="w-10 h-10 rounded-full object-cover border border-slate-200">` :
                    `<div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">${(window.currentUser.displayName || 'G')[0]}</div>`;
                
                container.innerHTML = `
                    <div class="relative group">
                        <button onclick="toggleUserMenu()" class="flex items-center space-x-2 focus:outline-none interactive-btn" title="${window.currentUser.displayName}">
                            ${avatar}
                        </button>
                        <div id="user-dropdown-menu" class="absolute right-0 mt-2 w-48 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 hidden z-50">
                            <div class="px-4 py-2 border-b border-slate-100">
                                <p class="text-xs font-bold text-slate-800 truncate">${escapeHtml(window.currentUser.displayName)}</p>
                                <p class="text-[10px] text-slate-400 truncate">${escapeHtml(window.currentUser.email || '')}</p>
                            </div>
                            <button onclick="logoutUser()" class="w-full text-left px-4 py-2 text-xs text-rose-600 hover:bg-rose-50 font-medium flex items-center space-x-2">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span>ログアウト</span>
                            </button>
                        </div>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <button onclick="openLoginModal(false)" class="px-3.5 py-2 bg-indigo-600 text-white rounded-xl text-xs font-bold shadow-md hover:bg-indigo-700 transition interactive-btn">
                        ログイン
                    </button>
                `;
            }
        }

        window.toggleUserMenu = function() {
            const menu = document.getElementById('user-dropdown-menu');
            if (menu) menu.classList.toggle('hidden');
        };

        window.saveNoteToDb = async function(note) {
            if (isFirebaseConnected && db) {
                try {
                    await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'notes', note.id), note);
                } catch(e) {
                    console.error("Error saving note to cloud:", e);
                    saveLocalFallback(note);
                }
            } else {
                saveLocalFallback(note);
            }
        };

        function saveLocalFallback(note) {
            const idx = window.notesData.findIndex(n => n.id === note.id);
            if (idx >= 0) window.notesData[idx] = note;
            else window.notesData.push(note);
            localStorage.setItem('freeboard_local_notes', JSON.stringify(window.notesData));
            if (typeof renderNotes === 'function') renderNotes();
            if (typeof renderSearchList === 'function') renderSearchList();
        }

        window.deleteNoteFromDb = async function(noteId) {
            if (isFirebaseConnected && db) {
                try {
                    await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'notes', noteId));
                } catch(e) {
                    console.error("Error deleting note from cloud:", e);
                    deleteLocalFallback(noteId);
                }
            } else {
                deleteLocalFallback(noteId);
            }
        };

        function deleteLocalFallback(noteId) {
            window.notesData = window.notesData.filter(n => n.id !== noteId);
            localStorage.setItem('freeboard_local_notes', JSON.stringify(window.notesData));
            if (typeof renderNotes === 'function') renderNotes();
            if (typeof renderSearchList === 'function') renderSearchList();
        }

        window.onload = () => {
            if (window.isAdminMode) {
                const subTitleEl = document.getElementById('header-subtitle');
                if (subTitleEl) {
                    subTitleEl.innerText = '編集者モード';
                    subTitleEl.className = 'text-[10px] font-bold text-indigo-600 block leading-tight';
                }
                const adminPanel = document.getElementById('admin-panel-container');
                if (adminPanel) adminPanel.classList.remove('hidden');
                if (typeof renderAdminTabs === 'function') renderAdminTabs();
            }
            window.initFirebase();
            if (typeof initCanvas === 'function') initCanvas();
        };
    </script>
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            background-color: #f1f5f9;
        }
        .canvas-bg {
            background-image: 
                radial-gradient(circle, #cbd5e1 1.5px, transparent 1.5px),
                radial-gradient(circle, #e2e8f0 1.5px, transparent 1.5px);
            background-position: 0 0, 20px 20px;
            background-size: var(--bg-size, 40px 40px);
        }
        .sticky-note {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
            touch-action: none;
        }
        .interactive-btn {
            touch-action: manipulation;
            pointer-events: auto;
        }
        .scrollable-list {
            touch-action: pan-y;
            -webkit-overflow-scrolling: touch;
        }
        @keyframes shockwave {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(2.5); opacity: 0; }
        }
        .animate-shockwave {
            animation: shockwave 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
    </style>
</head>
<body class="w-screen h-screen relative">

    <header class="absolute top-3 left-3 right-3 z-30 flex items-center justify-between pointer-events-none gap-2">
        <!-- Title Box -->
        <div class="bg-white/95 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-md border border-slate-200 pointer-events-auto flex items-center space-x-2.5 shrink-0">
            <div id="connection-indicator" class="w-3 h-3 rounded-full bg-amber-500 relative flex items-center justify-center shrink-0">
                <div id="connection-ping" class="absolute w-full h-full rounded-full bg-emerald-400 animate-shockwave hidden"></div>
            </div>
            <div>
                <h1 class="font-bold text-slate-800 text-xs sm:text-sm leading-tight">挑戦ボード</h1>
                <span id="header-subtitle" class="text-[10px] text-slate-400 leading-tight"></span>
            </div>
        </div>

        <!-- Right Controls: Search Trigger, Zoom, User Profile Icon -->
        <div class="flex items-center gap-2 pointer-events-auto shrink-0">
            <button onclick="openSearchModal()" class="w-11 h-11 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white rounded-2xl shadow-md flex items-center justify-center transition interactive-btn" title="投稿を検索">
                <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </button>

            <div class="bg-white/95 backdrop-blur-md px-2 py-1.5 rounded-2xl shadow-md border border-slate-200 flex items-center space-x-1">
                <button onclick="zoomIn()" class="w-8 h-8 rounded-xl hover:bg-indigo-50 text-indigo-600 flex items-center justify-center active:scale-95 transition interactive-btn" title="拡大">
                    <i class="fa-solid fa-magnifying-glass-plus text-xs"></i>
                </button>
                <span id="zoom-level" class="text-[11px] font-semibold text-slate-600 w-9 text-center">100%</span>
                <button onclick="zoomOut()" class="w-8 h-8 rounded-xl hover:bg-indigo-50 text-indigo-600 flex items-center justify-center active:scale-95 transition interactive-btn" title="縮小">
                    <i class="fa-solid fa-magnifying-glass-minus text-xs"></i>
                </button>
                <button onclick="resetView()" class="px-2.5 py-1.5 text-[11px] font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl active:scale-95 transition interactive-btn">
                    中央へ
                </button>
            </div>

            <!-- User Icon / Logout Control -->
            <div id="user-icon-container" class="bg-white/95 backdrop-blur-md p-1 rounded-2xl shadow-md border border-slate-200 flex items-center">
                <!-- Dynamic Loaded -->
            </div>
        </div>
    </header>

    <div id="viewport" class="w-full h-full relative overflow-hidden canvas-bg">
        <div id="canvas" class="absolute top-0 left-0 w-[5000px] h-[5000px] origin-top-left"></div>
    </div>

    <!-- Plus Button -->
    <div class="absolute bottom-24 right-6 md:bottom-20 md:right-8 z-40">
        <button onclick="handlePlusClick()" class="w-16 h-16 bg-indigo-600 hover:bg-indigo-700 active:scale-90 text-white rounded-full shadow-xl flex items-center justify-center text-2xl transition transform interactive-btn" title="新しい挑戦を書き込む">
            <i class="fa-solid fa-plus"></i>
        </button>
    </div>

    <!-- Admin Panel (Shown only in editor mode) -->
    <div id="admin-panel-container" class="absolute bottom-3 left-3 right-3 z-30 pointer-events-none hidden">
        <div class="max-w-2xl mx-auto bg-white/95 backdrop-blur-md rounded-2xl shadow-xl border border-indigo-100 p-3 pointer-events-auto flex flex-col space-y-2">
            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                <div class="flex items-center space-x-2">
                    <div class="w-6 h-6 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <span class="text-xs font-bold text-slate-800">編集者モード：ログインユーザー管理タブ</span>
                </div>
                <div class="flex items-center space-x-2 text-[11px]">
                    <span class="inline-flex items-center text-emerald-600 font-semibold"><span class="w-2 h-2 rounded-full bg-emerald-500 inline-block mr-1 animate-pulse"></span>今ログイン中</span>
                    <span class="text-slate-400">|</span>
                    <span class="text-slate-600 font-semibold">過去にログインしたアカウント一覧</span>
                </div>
            </div>
            <div id="admin-sessions-list" class="max-h-32 overflow-y-auto space-y-1.5 scrollable-list pr-1">
                <!-- Dynamically rendered -->
            </div>
        </div>
    </div>

    <!-- Login Modal -->
    <div id="login-modal" class="fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-sm flex items-center justify-center hidden opacity-0 transition-opacity duration-200 p-4">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-sm overflow-hidden transform scale-95 transition-transform duration-200 text-center p-6 space-y-4">
            <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-inner">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div class="space-y-1">
                <h3 id="login-modal-title" class="font-bold text-slate-800 text-lg">挑戦ボードへようこそ</h3>
                <p id="login-modal-desc" class="text-xs text-slate-500 leading-relaxed">付箋の投稿・編集を行うにはGoogleログインが必要です。見るだけの場合は「ボードを閲覧」を選択してください。</p>
            </div>
            <div class="space-y-2.5 pt-1">
                <button id="google-login-btn" onclick="googleLogin()" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-md flex items-center justify-center space-x-3 transition active:scale-95 interactive-btn">
                    <div class="bg-white p-1 rounded-full">
                        <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                    </div>
                    <span class="text-sm">Googleアカウントでログイン</span>
                </button>
                <button onclick="enterViewOnlyMode()" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-2xl text-xs transition active:scale-95 interactive-btn flex items-center justify-center space-x-2">
                    <i class="fa-regular fa-eye"></i>
                    <span>ボードを閲覧（見るだけ）</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Search Modal -->
    <div id="search-modal" onclick="if(event.target === this) closeSearchModal()" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden opacity-0 transition-opacity duration-200 p-4">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-lg max-h-[82vh] flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center justify-between shrink-0">
                <div class="flex items-center space-x-2">
                    <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <h3 class="font-bold text-slate-800 text-base">投稿を検索・一覧</h3>
                </div>
                <button type="button" onclick="closeSearchModal()" class="w-8 h-8 rounded-full hover:bg-slate-200 text-slate-400 hover:text-slate-700 flex items-center justify-center interactive-btn">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="p-4 border-b border-slate-100 space-y-2.5 bg-white shrink-0">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass text-indigo-600 text-xs absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="search-input" oninput="renderSearchList()" placeholder="キーワード・名前・タイトルで検索..." class="w-full pl-9 pr-9 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600">
                    <button type="button" id="clear-search-btn" onclick="clearSearchFilters()" class="hidden text-xs text-slate-400 hover:text-indigo-600 absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5">
                        クリア
                    </button>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <select id="grade-filter" onchange="renderSearchList()" class="w-full bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-600">
                        <option value="">学年すべて</option>
                        <option value="1年">1年</option>
                        <option value="2年">2年</option>
                        <option value="3年">3年</option>
                        <option value="4年">4年</option>
                        <option value="5年">5年</option>
                        <option value="6年">6年</option>
                    </select>
                    <select id="class-filter" onchange="renderSearchList()" class="w-full bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-600">
                        <option value="">学級すべて</option>
                        <option value="1組">1組</option>
                        <option value="2組">2組</option>
                        <option value="3組">3組</option>
                        <option value="4組">4組</option>
                        <option value="5組">5組</option>
                    </select>
                </div>

                <div class="flex items-center justify-between text-[11px] text-slate-500 pt-0.5 px-1">
                    <span id="search-count-label">全 0 件の投稿</span>
                    <span>カードをタップでボード上の場所へ移動</span>
                </div>
            </div>

            <div id="search-results-list" class="p-4 overflow-y-auto space-y-2.5 flex-1 bg-slate-50/70 scrollable-list"></div>
        </div>
    </div>

    <!-- Note Modal -->
    <div id="note-modal" onclick="if(event.target === this) closeModal()" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden opacity-0 transition-opacity duration-200 p-4">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-200">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center justify-between">
                <h3 id="modal-title-text" class="font-bold text-slate-800 text-base">新しい挑戦を書き込む</h3>
                <button type="button" onclick="closeModal()" class="w-8 h-8 rounded-full hover:bg-slate-200 text-slate-400 hover:text-slate-700 flex items-center justify-center interactive-btn">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
            
            <form id="note-form" onsubmit="handleFormSubmit(event)" class="p-5 space-y-4">
                <input type="hidden" id="note-id-input">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">タイトル</label>
                    <input type="text" id="note-title-input" placeholder="任意（空欄の場合は名前から自動作成）" class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">本文<span class="text-rose-500">*</span></label>
                    <textarea id="note-content-input" rows="3" required placeholder="本文" class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-sm resize-none"></textarea>
                </div>

                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">学年</label>
                        <select id="note-grade-input" class="w-full px-2 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
                            <option value="">選択</option>
                            <option value="1年">1年</option>
                            <option value="2年">2年</option>
                            <option value="3年">3年</option>
                            <option value="4年">4年</option>
                            <option value="5年">5年</option>
                            <option value="6年">6年</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">学級</label>
                        <select id="note-class-input" class="w-full px-2 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-600">
                            <option value="">選択</option>
                            <option value="1組">1組</option>
                            <option value="2組">2組</option>
                            <option value="3組">3組</option>
                            <option value="4組">4組</option>
                            <option value="5組">5組</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1.5">名前</label>
                        <input type="text" id="note-name-input" placeholder="名前" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-600 text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">付箋の色</label>
                    <div class="flex items-center justify-between px-2">
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="yellow" checked class="sr-only peer"><div class="w-9 h-9 rounded-full bg-amber-200 border-2 border-transparent peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="pink" class="sr-only peer"><div class="w-9 h-9 rounded-full bg-rose-200 border-2 border-transparent peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="blue" class="sr-only peer"><div class="w-9 h-9 rounded-full bg-sky-200 border-2 border-transparent peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="green" class="sr-only peer"><div class="w-9 h-9 rounded-full bg-emerald-200 border-2 border-transparent peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="purple" class="sr-only peer"><div class="w-9 h-9 rounded-full bg-purple-200 border-2 border-transparent peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                        <label class="cursor-pointer"><input type="radio" name="note-color" value="white" class="sr-only peer"><div class="w-9 h-9 rounded-full bg-white border-2 border-slate-300 peer-checked:border-indigo-600 shadow-sm transition"></div></label>
                    </div>
                </div>

                <div class="flex items-center justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeModal()" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 interactive-btn">キャンセル</button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-indigo-600 hover:bg-indigo-700 text-white shadow-md interactive-btn">ボードに貼る</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Admin Note Detail Modal -->
    <div id="admin-detail-modal" onclick="if(event.target === this) closeAdminDetailModal()" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center hidden opacity-0 transition-opacity duration-200 p-4">
        <div class="bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden transform scale-95 transition-transform duration-200">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-100 flex items-center justify-between shrink-0">
                <div class="flex items-center space-x-2">
                    <div class="w-7 h-7 rounded-xl bg-indigo-600 text-white flex items-center justify-center text-xs">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>
                    <h3 class="font-bold text-slate-800 text-base">付箋の詳細・編集履歴 (編集者モード)</h3>
                </div>
                <button type="button" onclick="closeAdminDetailModal()" class="w-8 h-8 rounded-full hover:bg-slate-200 text-slate-400 hover:text-slate-700 flex items-center justify-center interactive-btn">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>
            <div id="admin-detail-content" class="p-5 overflow-y-auto space-y-4 flex-1 bg-slate-50/50 scrollable-list text-xs sm:text-sm">
                <!-- Dynamically populated -->
            </div>
        </div>
    </div>

    <script>
        const colorMap = {
            yellow: { bg: 'bg-amber-100', border: 'border-amber-300', header: 'bg-amber-200/70', text: 'text-amber-900', accent: 'bg-amber-400' },
            pink: { bg: 'bg-rose-100', border: 'border-rose-300', header: 'bg-rose-200/70', text: 'text-rose-900', accent: 'bg-rose-400' },
            blue: { bg: 'bg-sky-100', border: 'border-sky-300', header: 'bg-sky-200/70', text: 'text-sky-900', accent: 'bg-sky-400' },
            green: { bg: 'bg-emerald-100', border: 'border-emerald-300', header: 'bg-emerald-200/70', text: 'text-emerald-900', accent: 'bg-emerald-400' },
            purple: { bg: 'bg-purple-100', border: 'border-purple-300', header: 'bg-purple-200/70', text: 'text-purple-900', accent: 'bg-purple-400' },
            white: { bg: 'bg-white', border: 'border-slate-200', header: 'bg-slate-100', text: 'text-slate-800', accent: 'bg-slate-300' }
        };

        let panX = 0;
        let panY = 0;
        let scale = 1.0;

        let pointers = new Map();
        let initialPinchDistance = null;
        let initialScale = 1;
        let isDraggingNote = false;
        let activeNoteId = null;
        let noteStartX = 0, noteStartY = 0;
        let dragStartPointerX = 0, dragStartPointerY = 0;
        let hasInitializedView = false;

        function initCanvas() {
            const viewport = document.getElementById('viewport');

            viewport.addEventListener('pointerdown', (e) => {
                if (e.target.closest('.sticky-note') || e.target.closest('button') || e.target.closest('input') || e.target.closest('textarea') || e.target.closest('select')) return;
                pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
            });

            viewport.addEventListener('pointermove', (e) => {
                if (!pointers.has(e.pointerId)) return;
                const prev = pointers.get(e.pointerId);
                const dx = e.clientX - prev.x;
                const dy = e.clientY - prev.y;
                pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

                if (pointers.size === 1 && !isDraggingNote) {
                    panX += dx;
                    panY += dy;
                    updateTransform();
                }
            });

            viewport.addEventListener('pointerup', (e) => {
                pointers.delete(e.pointerId);
                if (pointers.size < 2) initialPinchDistance = null;
            });
            viewport.addEventListener('pointercancel', (e) => {
                pointers.delete(e.pointerId);
                if (pointers.size < 2) initialPinchDistance = null;
            });

            viewport.addEventListener('touchstart', (e) => {
                if (e.touches.length === 2) {
                    initialPinchDistance = getHypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    initialScale = scale;
                }
            }, { passive: true });

            viewport.addEventListener('touchmove', (e) => {
                if (e.touches.length === 2 && initialPinchDistance) {
                    const currentDistance = getHypot(
                        e.touches[0].clientX - e.touches[1].clientX,
                        e.touches[0].clientY - e.touches[1].clientY
                    );
                    
                    const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
                    const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;

                    const newScale = Math.max(0.2, Math.min(3.0, initialScale * (currentDistance / initialPinchDistance)));
                    
                    panX = midX - (midX - panX) * (newScale / scale);
                    panY = midY - (midY - panY) * (newScale / scale);
                    scale = newScale;

                    updateTransform();
                }
            }, { passive: true });

            viewport.addEventListener('touchend', (e) => {
                if (e.touches.length < 2) {
                    initialPinchDistance = null;
                }
            }, { passive: true });

            renderNotes();
        }

        function fitAllNotes(force = false) {
            const viewport = document.getElementById('viewport');
            if (!viewport) return;

            if (!window.notesData || window.notesData.length === 0) {
                resetViewCenter();
                return;
            }

            if (hasInitializedView && !force) return;

            let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
            window.notesData.forEach(n => {
                if (n.x < minX) minX = n.x;
                if (n.y < minY) minY = n.y;
                if (n.x + 270 > maxX) maxX = n.x + 270;
                if (n.y + 200 > maxY) maxY = n.y + 200;
            });

            const padding = 120;
            minX -= padding;
            minY -= padding;
            maxX += padding;
            maxY += padding;

            const boardWidth = maxX - minX;
            const boardHeight = maxY - minY;

            const vWidth = viewport.clientWidth;
            const vHeight = viewport.clientHeight;

            if (vWidth === 0 || vHeight === 0) return;

            const scaleX = vWidth / boardWidth;
            const scaleY = vHeight / boardHeight;
            
            scale = Math.max(0.2, Math.min(3.0, Math.min(scaleX, scaleY)));

            panX = (vWidth / 2) - ((minX + maxX) / 2) * scale;
            panY = (vHeight / 2) - ((minY + maxY) / 2) * scale;

            hasInitializedView = true;
            updateTransform();
        }

        function resetViewCenter() {
            const viewport = document.getElementById('viewport');
            if (!viewport) return;
            scale = 1.0;
            panX = (viewport.clientWidth / 2) - 2500;
            panY = (viewport.clientHeight / 2) - 2500;
            updateTransform();
        }

        function getHypot(x, y) {
            return Math.sqrt(x * x + y * y);
        }

        function updateTransform() {
            const canvas = document.getElementById('canvas');
            const viewport = document.getElementById('viewport');

            canvas.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
            document.getElementById('zoom-level').innerText = Math.round(scale * 100) + '%';

            if (viewport) {
                const baseSize = 40;
                const scaledSize = baseSize * scale;
                viewport.style.setProperty('--bg-size', `${scaledSize}px ${scaledSize}px`);
                viewport.style.backgroundPosition = `${panX}px ${panY}px`;
            }
        }

        function zoomIn() {
            const viewport = document.getElementById('viewport');
            const cx = viewport.clientWidth / 2;
            const cy = viewport.clientHeight / 2;
            
            let currentPercent = Math.round(scale * 100);
            let nextPercent = Math.min(300, Math.floor((currentPercent + 20) / 20) * 20);
            if (nextPercent <= currentPercent) nextPercent = currentPercent + 20;
            if (nextPercent > 300) nextPercent = 300;

            const newScale = nextPercent / 100;
            panX = cx - (cx - panX) * (newScale / scale);
            panY = cy - (cy - panY) * (newScale / scale);
            scale = newScale;
            updateTransform();
        }

        function zoomOut() {
            const viewport = document.getElementById('viewport');
            const cx = viewport.clientWidth / 2;
            const cy = viewport.clientHeight / 2;

            let currentPercent = Math.round(scale * 100);
            let nextPercent = Math.max(20, Math.ceil((currentPercent - 20) / 20) * 20);
            if (nextPercent >= currentPercent) nextPercent = currentPercent - 20;
            if (nextPercent < 20) nextPercent = 20;

            const newScale = nextPercent / 100;
            panX = cx - (cx - panX) * (newScale / scale);
            panY = cy - (cy - panY) * (newScale / scale);
            scale = newScale;
            updateTransform();
        }

        function resetView() {
            scale = 1.0;
            resetViewCenter();
        }

        function renderNotes() {
            const canvas = document.getElementById('canvas');
            canvas.innerHTML = '';

            window.notesData.forEach(note => {
                const colors = colorMap[note.color] || colorMap.yellow;
                const div = document.createElement('div');
                div.id = `note-${note.id}`;
                div.className = `absolute sticky-note w-[270px] rounded-2xl border ${colors.border} ${colors.bg} flex flex-col overflow-hidden shadow-lg`;
                div.style.transform = `translate(${note.x}px, ${note.y}px)`;
                div.style.minHeight = '180px';

                if (window.isAdminMode) {
                    div.style.cursor = 'pointer';
                    div.onclick = (e) => {
                        if (e.target.closest('button')) return;
                        openAdminDetailModalForNote(note.id);
                    };
                }

                // 閲覧専用モード（未ログイン）の場合は自分の付箋でも編集・削除ボタンを表示しない
                const isLoggedIn = Boolean(window.currentUser);
                const isMyNote = (isLoggedIn && note.creatorId === window.myCreatorId) || window.isAdminMode;
                
                const actionButtonsHtml = isMyNote ? `
                    <div class="flex items-center space-x-1.5" onpointerdown="event.stopPropagation()">
                        <button type="button" onclick="openEditModal('${note.id}')" class="w-7 h-7 rounded-lg bg-black/5 hover:bg-black/10 flex items-center justify-center text-slate-700 text-xs transition interactive-btn" title="編集">
                            <i class="fa-solid fa-pen pointer-events-none"></i>
                        </button>
                        <button type="button" onclick="confirmDelete('${note.id}')" class="w-7 h-7 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 flex items-center justify-center text-rose-700 text-xs transition interactive-btn" title="削除">
                            <i class="fa-solid fa-trash-can pointer-events-none"></i>
                        </button>
                    </div>
                ` : '';

                const userAvatarHtml = (window.isAdminMode && note.userPhoto) ? 
                    `<img src="${note.userPhoto}" class="w-5 h-5 rounded-full object-cover mr-1.5 inline-block border border-slate-200">` : 
                    `<i class="fa-solid fa-user-pen mr-1"></i>`;

                const displayAuthor = window.isAdminMode ? (note.userName || note.author || '匿名') : (note.author || '匿名');

                div.innerHTML = `
                    <div class="note-header px-4 py-3 ${colors.header} border-b ${colors.border} flex items-center justify-between" onpointerdown="startDragNote(event, '${note.id}')">
                        <div class="flex items-center space-x-2 truncate pointer-events-none mr-2">
                            <span class="w-2.5 h-2.5 rounded-full ${colors.accent} shrink-0"></span>
                            <span class="font-bold text-xs ${colors.text} truncate">${escapeHtml(note.title)}</span>
                        </div>
                        <div>
                            ${actionButtonsHtml}
                        </div>
                    </div>
                    <div class="p-4 flex-1 flex flex-col justify-between pointer-events-none" onpointerdown="startDragNote(event, '${note.id}')">
                        <p class="text-xs sm:text-sm text-slate-700 whitespace-pre-wrap leading-relaxed pointer-events-auto">${escapeHtml(note.content)}</p>
                        <div class="mt-3 pt-2 border-t border-black/5 flex items-center justify-between text-[11px] text-slate-500 font-medium">
                            <span class="truncate max-w-[220px] flex items-center">${userAvatarHtml}${escapeHtml(displayAuthor)}</span>
                            ${(isLoggedIn && note.creatorId === window.myCreatorId) ? '<span class="text-[9px] bg-indigo-600/10 text-indigo-700 px-1.5 py-0.5 rounded-md font-semibold">あなたの投稿</span>' : ''}
                        </div>
                    </div>
                `;
                canvas.appendChild(div);
            });

            if (!hasInitializedView && window.notesData.length > 0) {
                fitAllNotes(false);
            }
        }

        function openAdminDetailModalForNote(noteId) {
            const note = window.notesData.find(n => n.id === noteId);
            if (!note) return;

            const container = document.getElementById('admin-detail-content');
            
            const createdAtStr = note.createdAt ? new Date(note.createdAt).toLocaleString('ja-JP') : '不明';
            const updatedAtStr = note.updatedAt ? new Date(note.updatedAt).toLocaleString('ja-JP') : '更新なし';
            
            let historyHtml = '<p class="text-slate-400 text-xs italic">編集履歴はありません</p>';
            if (note.history && note.history.length > 0) {
                historyHtml = note.history.map((h, idx) => `
                    <div class="bg-white p-3 rounded-2xl border border-slate-200 space-y-1">
                        <div class="flex items-center justify-between text-[11px] text-slate-400">
                            <span class="font-bold text-indigo-600">履歴 #${idx + 1}</span>
                            <span>${new Date(h.timestamp).toLocaleString('ja-JP')}</span>
                        </div>
                        <p class="text-xs text-slate-700 whitespace-pre-wrap">${escapeHtml(h.content)}</p>
                    </div>
                `).join('');
            }

            container.innerHTML = `
                <div class="space-y-4">
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 flex items-center space-x-3">
                        ${note.userPhoto ? `<img src="${note.userPhoto}" class="w-12 h-12 rounded-full object-cover border border-slate-200 shadow-sm">` : `<div class="w-12 h-12 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-lg">U</div>`}
                        <div>
                            <p class="text-xs text-slate-400">投稿ユーザー</p>
                            <p class="font-bold text-slate-800 text-sm">${escapeHtml(note.userName || note.author || '匿名')} <span class="text-[10px] text-slate-400 font-normal">(${escapeHtml(note.userEmail || 'ID: ' + note.creatorId)})</span></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <p class="text-[11px] text-slate-400 font-semibold mb-0.5"><i class="fa-regular fa-clock mr-1"></i>投稿時間</p>
                            <p class="text-xs font-bold text-slate-700">${createdAtStr}</p>
                        </div>
                        <div class="bg-white p-3.5 rounded-2xl border border-slate-200">
                            <p class="text-[11px] text-slate-400 font-semibold mb-0.5"><i class="fa-solid fa-rotate mr-1"></i>最終更新時間</p>
                            <p class="text-xs font-bold text-slate-700">${updatedAtStr}</p>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-2xl border border-slate-200 space-y-2">
                        <p class="text-xs font-bold text-slate-700">現在の付箋内容</p>
                        <p class="text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-100 whitespace-pre-wrap">${escapeHtml(note.content)}</p>
                    </div>

                    <div class="space-y-2">
                        <p class="text-xs font-bold text-slate-700 px-1">編集前のコメント履歴</p>
                        <div class="space-y-2">
                            ${historyHtml}
                        </div>
                    </div>
                </div>
            `;

            showModal('admin-detail-modal');
        }

        function closeAdminDetailModal() {
            closeModalById('admin-detail-modal');
        }

        function renderAdminTabs() {
            const listEl = document.getElementById('admin-sessions-list');
            if (!listEl) return;

            const sessions = window.loginSessions || [];
            if (sessions.length === 0) {
                listEl.innerHTML = `<p class="text-[11px] text-slate-400 text-center py-2">ログインセッション情報はありません</p>`;
                return;
            }

            listEl.innerHTML = sessions.map(s => `
                <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200 text-xs">
                    <div class="flex items-center space-x-2 truncate">
                        ${s.photoURL ? `<img src="${s.photoURL}" class="w-6 h-6 rounded-full object-cover">` : `<div class="w-6 h-6 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-[10px]">U</div>`}
                        <div class="truncate">
                            <span class="font-bold text-slate-800">${escapeHtml(s.displayName)}</span>
                            <span class="text-slate-400 text-[10px] ml-1">(${escapeHtml(s.email || s.uid)})</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 shrink-0">
                        ${s.isCurrent ? '<span class="px-2 py-0.5 bg-emerald-500 text-white text-[10px] font-bold rounded-full animate-pulse">今ログイン中</span>' : '<span class="px-2 py-0.5 bg-slate-200 text-slate-600 text-[10px] rounded-full">過去にログイン</span>'}
                    </div>
                </div>
            `).join('');
        }

        function openLoginModal(fromPlusButton = false) {
            const titleEl = document.getElementById('login-modal-title');
            const descEl = document.getElementById('login-modal-desc');
            if (titleEl && descEl) {
                if (fromPlusButton) {
                    titleEl.innerText = '投稿にはログインが必要です';
                    descEl.innerText = '新しい付箋を書き込むにはGoogleアカウントでログインしてください。';
                } else {
                    titleEl.innerText = '挑戦ボードへようこそ';
                    descEl.innerText = '付箋の投稿・編集を行うにはGoogleログインが必要です。見るだけの場合は「ボードを閲覧」を選択してください。';
                }
            }
            showModal('login-modal');
        }

        function closeLoginModal() {
            closeModalById('login-modal');
        }

        // プラスボタンを押したときの挙動：未ログインならログインモーダルを開く
        function handlePlusClick() {
            if (!window.currentUser) {
                openLoginModal(true);
                return;
            }
            openCreateModal();
        }

        function openSearchModal() {
            renderSearchList();
            showModal('search-modal');
            setTimeout(() => {
                const input = document.getElementById('search-input');
                if (input) input.focus();
            }, 150);
        }

        function closeSearchModal() {
            closeModalById('search-modal');
        }

        function clearSearchFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('grade-filter').value = '';
            document.getElementById('class-filter').value = '';
            renderSearchList();
        }

        function renderSearchList() {
            const listContainer = document.getElementById('search-results-list');
            const countLabel = document.getElementById('search-count-label');
            const clearBtn = document.getElementById('clear-search-btn');
            if (!listContainer) return;

            const keyword = (document.getElementById('search-input')?.value || '').trim().toLowerCase();
            const selectedGrade = document.getElementById('grade-filter')?.value || '';
            const selectedClass = document.getElementById('class-filter')?.value || '';

            if (clearBtn) {
                if (keyword || selectedGrade || selectedClass) clearBtn.classList.remove('hidden');
                else clearBtn.classList.add('hidden');
            }

            const filteredNotes = window.notesData.filter(note => {
                const authorStr = note.author || '';
                const matchesKeyword = !keyword || 
                    (note.title && note.title.toLowerCase().includes(keyword)) ||
                    (note.content && note.content.toLowerCase().includes(keyword)) ||
                    (authorStr.toLowerCase().includes(keyword));

                const matchesGrade = !selectedGrade || authorStr.includes(selectedGrade);
                const matchesClass = !selectedClass || authorStr.includes(selectedClass);

                return matchesKeyword && matchesGrade && matchesClass;
            });

            if (countLabel) countLabel.innerText = `${filteredNotes.length} 件の投稿が見つかりました`;

            if (filteredNotes.length === 0) {
                listContainer.innerHTML = `
                    <div class="py-12 text-center text-slate-400">
                        <i class="fa-regular fa-folder-open text-2xl mb-2 block"></i>
                        <p class="text-xs">条件に一致する投稿がありません</p>
                    </div>
                `;
                return;
            }

            listContainer.innerHTML = filteredNotes.map(note => {
                const colors = colorMap[note.color] || colorMap.yellow;
                return `
                    <div onclick="jumpToNote('${note.id}')" class="p-3.5 rounded-2xl border ${colors.border} ${colors.bg} cursor-pointer hover:shadow-md active:scale-[0.99] transition">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center space-x-2 truncate">
                                <span class="w-2.5 h-2.5 rounded-full ${colors.accent} shrink-0"></span>
                                <span class="font-bold text-xs sm:text-sm ${colors.text} truncate">${escapeHtml(note.title)}</span>
                            </div>
                            <span class="text-[11px] font-medium text-slate-600 bg-white/70 px-2 py-0.5 rounded-lg shrink-0">
                                ${escapeHtml(note.author || '匿名')}
                            </span>
                        </div>
                        <p class="text-xs text-slate-700 whitespace-pre-wrap leading-relaxed line-clamp-3">${escapeHtml(note.content)}</p>
                    </div>
                `;
            }).join('');
        }

        function jumpToNote(id) {
            const note = window.notesData.find(n => n.id === id);
            if (!note) return;

            closeSearchModal();
            const viewport = document.getElementById('viewport');
            if (!viewport) return;

            scale = 1.0;
            const noteCenterX = note.x + 135;
            const noteCenterY = note.y + 90;
            panX = (viewport.clientWidth / 2) - noteCenterX * scale;
            panY = (viewport.clientHeight / 2) - noteCenterY * scale;
            updateTransform();

            setTimeout(() => {
                const el = document.getElementById(`note-${id}`);
                if (el) {
                    el.classList.add('ring-4', 'ring-indigo-600');
                    setTimeout(() => el.classList.remove('ring-4', 'ring-indigo-600'), 1800);
                }
            }, 50);
        }

        function startDragNote(e, id) {
            e.stopPropagation();
            const note = window.notesData.find(n => n.id === id);
            if (!note) return;

            // 未ログイン（閲覧モード）では移動不可
            const canMove = (Boolean(window.currentUser) && note.creatorId === window.myCreatorId) || window.isAdminMode;

            if (!canMove) {
                pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
                return;
            }

            isDraggingNote = true;
            activeNoteId = id;
            dragStartPointerX = e.clientX;
            dragStartPointerY = e.clientY;
            
            noteStartX = note.x;
            noteStartY = note.y;

            const moveHandler = (moveEvent) => {
                if (!isDraggingNote || activeNoteId !== id) return;
                const dx = (moveEvent.clientX - dragStartPointerX) / scale;
                const dy = (moveEvent.clientY - dragStartPointerY) / scale;
                const targetNote = window.notesData.find(n => n.id === id);
                if (targetNote) {
                    targetNote.x = noteStartX + dx;
                    targetNote.y = noteStartY + dy;
                    const el = document.getElementById(`note-${id}`);
                    if (el) el.style.transform = `translate(${targetNote.x}px, ${targetNote.y}px)`;
                }
            };

            const upHandler = () => {
                if (isDraggingNote && activeNoteId === id) {
                    isDraggingNote = false;
                    const targetNote = window.notesData.find(n => n.id === id);
                    if (targetNote) saveNoteToDb(targetNote);
                    activeNoteId = null;
                }
                window.removeEventListener('pointermove', moveHandler);
                window.removeEventListener('pointerup', upHandler);
            };

            window.addEventListener('pointermove', moveHandler);
            window.addEventListener('pointerup', upHandler);
        }

        function openCreateModal() {
            if (!window.currentUser) {
                openLoginModal(true);
                return;
            }
            document.getElementById('note-id-input').value = '';
            document.getElementById('modal-title-text').innerText = '新しい挑戦を書き込む';
            document.getElementById('note-title-input').value = '';
            document.getElementById('note-content-input').value = '';
            document.getElementById('note-grade-input').value = '';
            document.getElementById('note-class-input').value = '';
            document.getElementById('note-name-input').value = '';
            document.querySelector('input[name="note-color"][value="yellow"]').checked = true;
            showModal('note-modal');
        }

        function openEditModal(id) {
            if (!window.currentUser && !window.isAdminMode) return;
            const note = window.notesData.find(n => n.id === id);
            if (!note || (note.creatorId !== window.myCreatorId && !window.isAdminMode)) return;

            document.getElementById('note-id-input').value = note.id;
            document.getElementById('modal-title-text').innerText = '挑戦を編集する';
            document.getElementById('note-title-input').value = note.title || '';
            document.getElementById('note-content-input').value = note.content || '';
            
            const authorParts = (note.author || '').split(/[\s\-]/);
            document.getElementById('note-grade-input').value = authorParts[0] || '';
            document.getElementById('note-class-input').value = authorParts[1] || '';
            document.getElementById('note-name-input').value = authorParts.slice(2).join(' ') || authorParts[2] || '';
            
            const colorRadio = document.querySelector(`input[name="note-color"][value="${note.color || 'yellow'}"]`);
            if (colorRadio) colorRadio.checked = true;

            showModal('note-modal');
        }

        function confirmDelete(id) {
            if (!window.currentUser && !window.isAdminMode) return;
            const note = window.notesData.find(n => n.id === id);
            if (!note || (note.creatorId !== window.myCreatorId && !window.isAdminMode)) return;

            if (confirm('この付箋を削除してもよろしいですか？')) {
                deleteNoteFromDb(id);
            }
        }

        function showModal(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                const content = modal.firstElementChild;
                if (content) content.classList.remove('scale-95');
            }, 10);
        }

        function closeModalById(modalId) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.add('opacity-0');
            const content = modal.firstElementChild;
            if (content) content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function closeModal() {
            closeModalById('note-modal');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            if (!window.currentUser && !window.isAdminMode) {
                openLoginModal(true);
                return;
            }

            const idInput = document.getElementById('note-id-input').value;
            let title = document.getElementById('note-title-input').value.trim();
            const content = document.getElementById('note-content-input').value.trim();
            
            const grade = document.getElementById('note-grade-input').value.trim();
            const cls = document.getElementById('note-class-input').value.trim();
            const name = document.getElementById('note-name-input').value.trim();

            let authorParts = [];
            if (grade) authorParts.push(grade);
            if (cls) authorParts.push(cls);
            if (name) authorParts.push(name);
            const author = authorParts.join(' ');

            if (!content) return;

            if (!title) {
                if (name) title = name + 'の挑戦';
                else if (author) title = author + 'の挑戦';
                else title = 'みんなの挑戦';
            }

            const now = new Date().toISOString();
            const currentUserName = window.currentUser ? window.currentUser.displayName : (name || '匿名');
            const currentUserPhoto = window.currentUser ? window.currentUser.photoURL : '';
            const currentUserEmail = window.currentUser ? window.currentUser.email : '';

            if (idInput) {
                const existingNote = window.notesData.find(n => n.id === idInput);
                if (existingNote && (existingNote.creatorId === window.myCreatorId || window.isAdminMode)) {
                    if (existingNote.content !== content) {
                        if (!existingNote.history) existingNote.history = [];
                        existingNote.history.push({
                            content: existingNote.content,
                            timestamp: existingNote.updatedAt || existingNote.createdAt || now
                        });
                    }

                    existingNote.title = title;
                    existingNote.content = content;
                    existingNote.author = author;
                    existingNote.color = document.querySelector('input[name="note-color"]:checked').value;
                    existingNote.updatedAt = now;
                    saveNoteToDb(existingNote);
                }
            } else {
                const viewport = document.getElementById('viewport');
                const centerX = (-panX + viewport.clientWidth / 2) / scale + (Math.random() * 60 - 30);
                const centerY = (-panY + viewport.clientHeight / 2) / scale + (Math.random() * 60 - 30);

                const newNote = {
                    id: 'note_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
                    title: title,
                    content: content,
                    author: author,
                    color: document.querySelector('input[name="note-color"]:checked').value,
                    x: Math.max(200, Math.min(4800, centerX)),
                    y: Math.max(200, Math.min(4800, centerY)),
                    creatorId: window.myCreatorId,
                    userName: currentUserName,
                    userPhoto: currentUserPhoto,
                    userEmail: currentUserEmail,
                    createdAt: now,
                    updatedAt: null,
                    history: []
                };
                window.notesData.push(newNote);
                saveNoteToDb(newNote);
            }

            closeModal();
            renderNotes();
            renderSearchList();
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
        }
    </script>
</body>
</html>
